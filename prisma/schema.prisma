generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                  String                @id @db.Uuid
  fullName            String
  email               String                @unique
  phone               String?
  role                Role                  @default(OPERATOR)
  department          String?
  isActive            Boolean               @default(true)
  avatarUrl           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  assignmentsCreated  ChecklistAssignment[] @relation("AssignedBy")
  assignmentsReceived ChecklistAssignment[] @relation("AssignedTo")
  reviews             ChecklistSubmission[] @relation("ReviewedBy")
  submissions         ChecklistSubmission[] @relation("SubmittedBy")
  comments            Comment[]

  @@map("profiles")
}

model ChecklistTemplate {
  id               String                @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  category         String
  isActive         Boolean               @default(true)
  isAuditTemplate  Boolean               @default(false)
  createdById      String                @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  assignments      ChecklistAssignment[]
  items            ChecklistItem[]

  @@map("checklist_templates")
}

model ChecklistItem {
  id              String            @id @default(uuid()) @db.Uuid
  templateId      String            @db.Uuid
  label           String
  description     String?
  type            ItemType          @default(REQUIRED)
  sortOrder       Int               @default(0)
  requiresPhoto   Boolean           @default(false)
  requiresVideo   Boolean           @default(false)
  isActive        Boolean           @default(true)
  template        ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissionItems SubmissionItem[]

  @@map("checklist_items")
}

model ChecklistAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  templateId   String               @db.Uuid
  assignedToId String               @db.Uuid
  assignedById String               @db.Uuid
  dueDate      DateTime?
  createdAt    DateTime             @default(now())
  assignedBy   Profile              @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedTo   Profile              @relation("AssignedTo", fields: [assignedToId], references: [id])
  template     ChecklistTemplate    @relation(fields: [templateId], references: [id])
  submission   ChecklistSubmission?

  @@map("checklist_assignments")
}

model ChecklistSubmission {
  id            String              @id @default(uuid()) @db.Uuid
  assignmentId  String              @unique @db.Uuid
  submittedById String              @db.Uuid
  status        ChecklistStatus     @default(DRAFT)
  submittedAt   DateTime?
  reviewedById  String?             @db.Uuid
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  location      String?
  assignment    ChecklistAssignment @relation(fields: [assignmentId], references: [id])
  reviewedBy    Profile?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  submittedBy   Profile             @relation("SubmittedBy", fields: [submittedById], references: [id])
  comments      Comment[]
  photos        Photo[]
  videos        Video[]
  history       StatusHistory[]
  items         SubmissionItem[]

  @@map("checklist_submissions")
}

model SubmissionItem {
  id              String              @id @default(uuid()) @db.Uuid
  submissionId    String              @db.Uuid
  checklistItemId String              @db.Uuid
  isChecked       Boolean             @default(false)
  note            String?
  photos          Photo[]
  videos          Video[]
  checklistItem   ChecklistItem       @relation(fields: [checklistItemId], references: [id])
  submission      ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, checklistItemId])
  @@map("submission_items")
}

model Photo {
  id               String              @id @default(uuid()) @db.Uuid
  submissionId     String              @db.Uuid
  submissionItemId String?             @db.Uuid
  storagePath      String
  fileName         String
  fileSizeBytes    Int?
  uploadedAt       DateTime            @default(now())
  submission       ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionItem   SubmissionItem?     @relation(fields: [submissionItemId], references: [id])

  @@map("photos")
}

model Video {
  id               String              @id @default(uuid()) @db.Uuid
  submissionId     String              @db.Uuid
  submissionItemId String?             @db.Uuid
  storagePath      String
  fileName         String
  fileSizeBytes    Int?
  uploadedAt       DateTime            @default(now())
  submission       ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionItem   SubmissionItem?     @relation(fields: [submissionItemId], references: [id])

  @@map("videos")
}

model Comment {
  id              String              @id @default(uuid()) @db.Uuid
  submissionId    String              @db.Uuid
  authorId        String              @db.Uuid
  body            String
  isReviewComment Boolean             @default(false)
  createdAt       DateTime            @default(now())
  author          Profile             @relation(fields: [authorId], references: [id])
  submission      ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model StatusHistory {
  id           String              @id @default(uuid()) @db.Uuid
  submissionId String              @db.Uuid
  fromStatus   ChecklistStatus?
  toStatus     ChecklistStatus
  changedById  String              @db.Uuid
  changedAt    DateTime            @default(now())
  note         String?
  submission   ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("status_history")
}

enum Role {
  OPERATOR
  ADMIN
  REVIEWER
  MASTER_ADMIN
}

enum ChecklistStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ItemType {
  REQUIRED
  OPTIONAL
}
